<!-- Unitree Z1 arm with the Unitree gripper: bridge component model for unitree_mujoco.
  Converted from unitreerobotics/unitree_ros robots/z1_description (BSD-3-Clause, see LICENSE):
  xacro/robot.xacro with UnitreeGripper:=true and xacro/const.xacro (z1.urdf in that directory is the
  variant without gripper). Kinematics, joint limits, effort limits, masses and inertias are the
  URDF's; joint damping and friction are the URDF <dynamics> values. Visual meshes are the URDF's
  collision STLs (meshes/collision, link frames, metres) decimated to about 2000 triangles each;
  collision geometry is the URDF's cylinders for the arm links and boxes approximating the gripper
  jaws (the URDF uses the gripper meshes). Armature (0.01 kg m^2 per joint) is a tuning value, not
  measured: it keeps an explicit 1 kHz PD with the z1_sdk gains stable at a 2 ms time step.
  Frame of body "link00" = URDF link00 (base flange, z up, x forward). Attach it with a prefix
  (see simulate/src/robot_compose.h), e.g. "z1_": names below then become z1_joint1 etc.
  Motors, in the order of the z1_arm bridge component (rt/z1/cmd, rt/z1/state):
  joint1 .. joint6, gripper (joint jointGripper, 0 = closed, -pi/2 = open).
  Torque actuators; the PD law is evaluated by the z1_arm bridge component.
  At q = 0 the arm is folded (the Z1 rest pose); joint2 and joint3 then rest on their limits. -->
<mujoco model="z1">
  <compiler angle="radian" meshdir="meshes"/>

  <default>
    <default class="z1">
      <joint damping="1" frictionloss="1" armature="0.01"/>
      <geom friction="1 0.01 0.001"/>
      <default class="z1_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0" rgba="0.22 0.22 0.24 1"/>
      </default>
      <default class="z1_collision">
        <geom group="3" density="0" rgba="0.5 0.5 0.6 0.5"/>
      </default>
    </default>
  </default>

  <asset>
    <mesh name="z1_link00" file="Link00.stl"/>
    <mesh name="z1_link01" file="Link01.stl"/>
    <mesh name="z1_link02" file="Link02.stl"/>
    <mesh name="z1_link03" file="Link03.stl"/>
    <mesh name="z1_link04" file="Link04.stl"/>
    <mesh name="z1_link05" file="Link05.stl"/>
    <mesh name="z1_link06" file="Link06.stl"/>
    <mesh name="z1_gripper_stator" file="GripperStator.stl"/>
    <mesh name="z1_gripper_mover" file="GripperMover.stl"/>
  </asset>

  <worldbody>
    <body name="link00" childclass="z1">
      <inertial pos="-0.00334984 -0.00013615 0.02495843" mass="0.47247481" fullinertia="0.00037937 0.00041521 0.00053066 -0.00000035 -0.00001037 -0.00000099"/>
      <geom class="z1_visual" mesh="z1_link00"/>
      <geom class="z1_collision" name="link00_collision" type="cylinder" size="0.0325 0.0255" pos="0 0 0.0255"/>
      <body name="link01" pos="0 0 0.0585">
        <inertial pos="0.00000247 -0.00025198 0.02317169" mass="0.67332551" fullinertia="0.00128328 0.00071931 0.00083936 -0.00000006 -0.00000040 0.00000050"/>
        <joint name="joint1" axis="0 0 1" range="-2.6179938780 2.6179938780" actuatorfrcrange="-30 30"/>
        <geom class="z1_visual" mesh="z1_link01"/>
        <body name="link02" pos="0 0 0.045">
          <inertial pos="-0.11012601 0.00240029 0.00158266" mass="1.19132258" fullinertia="0.00102138 0.02429457 0.02466114 0.00062358 0.00000513 -0.00000210"/>
          <joint name="joint2" axis="0 1 0" range="0 2.9670597284" actuatorfrcrange="-60 60"/>
          <geom class="z1_visual" mesh="z1_link02"/>
          <geom class="z1_collision" name="link02_collision_0" type="cylinder" size="0.0325 0.051" zaxis="0 1 0"/>
          <geom class="z1_collision" name="link02_collision_1" type="cylinder" size="0.0225 0.1175" pos="-0.1625 0 0" zaxis="1 0 0"/>
          <geom class="z1_collision" name="link02_collision_2" type="cylinder" size="0.0325 0.0255" pos="-0.35 0 0" zaxis="0 1 0"/>
          <body name="link03" pos="-0.35 0 0">
            <inertial pos="0.10609208 -0.00541815 0.03476383" mass="0.83940874" fullinertia="0.00108061 0.00954238 0.00886621 -0.00008669 -0.00208102 -0.00001332"/>
            <joint name="joint3" axis="0 1 0" range="-2.8797932658 0" actuatorfrcrange="-30 30"/>
            <geom class="z1_visual" mesh="z1_link03"/>
            <geom class="z1_collision" name="link03_collision_0" type="cylinder" size="0.02 0.058" pos="0.128 0 0.055" zaxis="1 0 0"/>
            <geom class="z1_collision" name="link03_collision_1" type="cylinder" size="0.0325 0.0295" pos="0.2205 0 0.055" zaxis="0 1 0"/>
            <body name="link04" pos="0.218 0 0.057">
              <inertial pos="0.04366681 0.00364738 -0.00170192" mass="0.56404563" fullinertia="0.00031576 0.00092996 0.00097912 0.00008130 0.00004091 -0.00000596"/>
              <joint name="joint4" axis="0 1 0" range="-1.5184364492 1.5184364492" actuatorfrcrange="-30 30"/>
              <geom class="z1_visual" mesh="z1_link04"/>
              <geom class="z1_collision" name="link04_collision" type="cylinder" size="0.0325 0.0335" pos="0.072 0 0"/>
              <body name="link05" pos="0.07 0 0">
                <inertial pos="0.03121533 0 0.00646316" mass="0.38938492" fullinertia="0.00017605 0.00055896 0.00053860 0.00000040 0.00005689 -0.00000013"/>
                <joint name="joint5" axis="0 0 1" range="-1.3439035240 1.3439035240" actuatorfrcrange="-30 30"/>
                <geom class="z1_visual" mesh="z1_link05"/>
                <body name="link06" pos="0.0492 0 0">
                  <inertial pos="0.02415690 -0.00017355 -0.00143876" mass="0.28875807" fullinertia="0.00018328 0.00014750 0.00014680 0.00000122 0.00000054 0.00000008"/>
                  <joint name="joint6" axis="1 0 0" range="-2.7925268032 2.7925268032" actuatorfrcrange="-30 30"/>
                  <geom class="z1_visual" mesh="z1_link06"/>
                  <geom class="z1_collision" name="link06_collision" type="cylinder" size="0.0325 0.0255" pos="0.0255 0 0" zaxis="1 0 0"/>
                  <body name="gripperStator" pos="0.051 0 0">
                    <inertial pos="0.04764427 -0.00035819 -0.00249162" mass="0.52603655" fullinertia="0.00038683 0.00068614 0.00066293 -0.00000359 0.00007662 0.00000209"/>
                    <geom class="z1_visual" mesh="z1_gripper_stator"/>
                    <geom class="z1_collision" name="gripper_stator_body" type="box" size="0.0485 0.041 0.0305" pos="0.0415 0 -0.0055"/>
                    <geom class="z1_collision" name="gripper_stator_jaw" type="box" size="0.0295 0.036 0.0135" pos="0.1195 0 -0.0225"/>
                    <site name="ee" pos="0.13 0 0" size="0.005" group="4"/>
                    <body name="gripperMover" pos="0.049 0 0">
                      <inertial pos="0.01320633 0.00476708 0.00380534" mass="0.27621302" fullinertia="0.00017716 0.00026787 0.00035728 0.00001683 -0.00001786 0.00000262"/>
                      <joint name="jointGripper" axis="0 1 0" range="-1.5707963268 0" actuatorfrcrange="-30 30"/>
                      <geom class="z1_visual" mesh="z1_gripper_mover"/>
                      <geom class="z1_collision" name="gripper_mover_base" type="box" size="0.0305 0.041 0.0165" pos="0.0095 0 0.0095"/>
                      <geom class="z1_collision" name="gripper_mover_jaw" type="box" size="0.0275 0.039 0.016" pos="0.0725 0 0.007"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <!-- folded rest pose (q = 0): the URDF's link06 cylinder overlaps link02's elbow cylinder -->
    <exclude body1="link02" body2="link06"/>
  </contact>

  <actuator>
    <motor name="joint1" joint="joint1" ctrlrange="-30 30"/>
    <motor name="joint2" joint="joint2" ctrlrange="-60 60"/>
    <motor name="joint3" joint="joint3" ctrlrange="-30 30"/>
    <motor name="joint4" joint="joint4" ctrlrange="-30 30"/>
    <motor name="joint5" joint="joint5" ctrlrange="-30 30"/>
    <motor name="joint6" joint="joint6" ctrlrange="-30 30"/>
    <motor name="gripper" joint="jointGripper" ctrlrange="-30 30"/>
  </actuator>

  <sensor>
    <jointpos name="joint1_pos" joint="joint1"/>
    <jointpos name="joint2_pos" joint="joint2"/>
    <jointpos name="joint3_pos" joint="joint3"/>
    <jointpos name="joint4_pos" joint="joint4"/>
    <jointpos name="joint5_pos" joint="joint5"/>
    <jointpos name="joint6_pos" joint="joint6"/>
    <jointpos name="gripper_pos" joint="jointGripper"/>
    <jointvel name="joint1_vel" joint="joint1"/>
    <jointvel name="joint2_vel" joint="joint2"/>
    <jointvel name="joint3_vel" joint="joint3"/>
    <jointvel name="joint4_vel" joint="joint4"/>
    <jointvel name="joint5_vel" joint="joint5"/>
    <jointvel name="joint6_vel" joint="joint6"/>
    <jointvel name="gripper_vel" joint="jointGripper"/>
    <jointactuatorfrc name="joint1_torque" joint="joint1"/>
    <jointactuatorfrc name="joint2_torque" joint="joint2"/>
    <jointactuatorfrc name="joint3_torque" joint="joint3"/>
    <jointactuatorfrc name="joint4_torque" joint="joint4"/>
    <jointactuatorfrc name="joint5_torque" joint="joint5"/>
    <jointactuatorfrc name="joint6_torque" joint="joint6"/>
    <jointactuatorfrc name="gripper_torque" joint="jointGripper"/>
  </sensor>
</mujoco>
